# 统一换行符：仓库内一律 LF，避免 Windows/macOS 贡献者互相污染
* text=auto eol=lf

# Windows 专用脚本必须保留 CRLF，否则 PowerShell / cmd 可能报错
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.ttf binary
*.exe binary
*.dll binary
*.zip binary
*.7z binary

# 锁文件与生成物不计入语言统计
pnpm-lock.yaml linguist-generated=true -diff
