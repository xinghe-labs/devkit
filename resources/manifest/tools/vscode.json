{
  "id": "vscode",
  "category": "editor",
  "tier": "L2",
  "status": "detect-only",
  "provider": "direct",
  "name": { "zh-CN": "Visual Studio Code", "en-US": "Visual Studio Code" },
  "description": {
    "zh-CN": "轻量跨平台代码编辑器。",
    "en-US": "Lightweight cross-platform code editor."
  },
  "homepage": "https://code.visualstudio.com",
  "license": { "spdx": "LicenseRef-Microsoft-VSCode", "redistributable": false },
  "detect": {
    "commands": [{ "cmd": "code", "args": ["--version"], "expectRegex": "\\d+\\.\\d+\\.\\d+" }],
    "files": ["%LOCALAPPDATA%\\Programs\\Microsoft VS Code\\Code.exe"],
    "registry": [
      {
        "hive": "HKCU",
        "view": "64",
        "path": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall",
        "match": { "DisplayName": "^Microsoft Visual Studio Code" },
        "versionFrom": "DisplayVersion"
      },
      {
        "hive": "HKLM",
        "view": "64",
        "path": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall",
        "match": { "DisplayName": "^Microsoft Visual Studio Code" },
        "versionFrom": "DisplayVersion"
      }
    ]
  },
  "versions": [],
  "notes": {
    "zh-CN": "源码是 MIT，但官方发行物走 Microsoft 产品许可，因此标记为 L2：可自动下载安装，但不进离线包。",
    "en-US": "The source is MIT but the official build ships under Microsoft's product license, hence L2: auto-download allowed, excluded from offline bundles."
  }
}
