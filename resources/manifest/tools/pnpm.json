{
  "id": "pnpm",
  "category": "tool",
  "tier": "L1",
  "status": "ready",
  "provider": "direct",
  "name": {
    "zh-CN": "pnpm",
    "en-US": "pnpm"
  },
  "description": {
    "zh-CN": "磁盘占用小、安装速度快的 Node 包管理器（独立二进制，不依赖 npm）。",
    "en-US": "Fast, disk-efficient Node package manager shipped as a standalone binary."
  },
  "homepage": "https://pnpm.io",
  "license": {
    "spdx": "MIT",
    "redistributable": true
  },
  "detect": {
    "commands": [
      {
        "cmd": "pnpm",
        "args": [
          "--version"
        ],
        "expectRegex": "^\\d+\\.\\d+"
      }
    ]
  },
  "versions": [
    {
      "version": "12.11.2",
      "channel": "stable",
      "recommended": true,
      "arch": "x64",
      "sizeBytes": 22582408,
      "installScope": "user",
      "source": {
        "url": "https://github.com/pnpm/pnpm/releases/download/v12.11.2/pnpm-win32-x64.zip",
        "sha256": "66cac6b725bfc75fadac959fc435821048558adb50b89c82d0d2d5e57465a1dd"
      },
      "mirrors": [
        {
          "name": "ghproxy",
          "url": "https://ghfast.top/https://github.com/pnpm/pnpm/releases/download/v12.11.2/pnpm-win32-x64.zip"
        }
      ],
      "install": {
        "type": "zip",
        "template": "zip-single-file-into-version-dir",
        "params": {
          "fileName": "pnpm.exe"
        }
      },
      "uninstall": {
        "type": "custom"
      },
      "activate": {
        "pathEntries": [
          "{currentDir}"
        ]
      },
      "verify": {
        "cmd": "{installDir}\\pnpm.exe",
        "args": [
          "--version"
        ],
        "expectRegex": "\\d+\\.\\d+"
      }
    }
  ],
  "notes": {
    "zh-CN": "用官方独立二进制而不是 npm i -g pnpm：独立二进制不依赖 Node，也就不会出现\"还没装 Node 就装不了 pnpm\"的死锁。",
    "en-US": "Uses the standalone binary instead of npm i -g pnpm: no Node dependency, so there is no chicken-and-egg problem."
  }
}
