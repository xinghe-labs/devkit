{
  "id": "python",
  "category": "runtime",
  "tier": "L1",
  "status": "ready",
  "provider": "direct",
  "name": {
    "zh-CN": "Python",
    "en-US": "Python"
  },
  "description": {
    "zh-CN": "通用编程语言运行时，自带 pip。用户级安装，不改系统 PATH。",
    "en-US": "General purpose language runtime with pip bundled. Per-user install, no system PATH edits."
  },
  "homepage": "https://www.python.org",
  "license": {
    "spdx": "PSF-2.0",
    "redistributable": true
  },
  "detect": {
    "commands": [
      {
        "cmd": "python",
        "args": [
          "--version"
        ],
        "expectRegex": "Python \\d+\\.\\d+"
      },
      {
        "cmd": "py",
        "args": [
          "-3",
          "--version"
        ],
        "expectRegex": "Python \\d+\\.\\d+"
      }
    ],
    "registry": [
      {
        "hive": "HKCU",
        "view": "64",
        "path": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall",
        "match": {
          "DisplayName": "^Python \\d"
        },
        "versionFrom": "DisplayVersion"
      },
      {
        "hive": "HKLM",
        "view": "64",
        "path": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall",
        "match": {
          "DisplayName": "^Python \\d"
        },
        "versionFrom": "DisplayVersion"
      }
    ]
  },
  "versions": [
    {
      "version": "3.15.0",
      "channel": "stable",
      "arch": "x64",
      "sizeBytes": 45383680,
      "installScope": "user",
      "source": {
        "url": "https://www.python.org/ftp/python/3.15.0/python-3.15.0-amd64.exe",
        "sha256": "67d9a63eb145a34aa939f02eadbf8c57f21fcdd6decb901ccac578d2d1f01d6f"
      },
      "mirrors": [
        {
          "name": "huaweicloud",
          "url": "https://mirrors.huaweicloud.com/python/3.15.0/python-3.15.0-amd64.exe"
        }
      ],
      "install": {
        "type": "exe-custom",
        "template": "exe-python-silent",
        "params": {
          "includeLauncher": "1",
          "includePip": "1"
        }
      },
      "uninstall": {
        "type": "custom"
      },
      "activate": {
        "pathEntries": [
          "{currentDir}",
          "{currentDir}\\Scripts"
        ]
      },
      "verify": {
        "cmd": "{installDir}\\python.exe",
        "args": [
          "--version"
        ],
        "expectRegex": "Python \\d+\\.\\d+"
      }
    },
    {
