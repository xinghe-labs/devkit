  "notes": {
    "zh-CN": "Apache 只发布 .sha512，没有 .sha256，所以 SHA-256 由本地下载后计算（约 9 MB）。",
    "en-US": "Apache only publishes .sha512, so the SHA-256 is computed locally after downloading (~9 MB)."
  }
}
