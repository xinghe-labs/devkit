{
  "id": "maven",
  "category": "build",
  "tier": "L1",
  "status": "ready",
  "provider": "direct",
  "name": {
    "zh-CN": "Apache Maven",
    "en-US": "Apache Maven"
  },
  "description": {
    "zh-CN": "Java 项目的依赖管理与构建工具。",
    "en-US": "Dependency management and build tool for Java projects."
  },
  "homepage": "https://maven.apache.org",
  "license": {
    "spdx": "Apache-2.0",
    "redistributable": true
  },
  "detect": {
    "commands": [
      {
        "cmd": "mvn",
        "args": [
          "-v"
        ],
        "expectRegex": "Apache Maven \\d+"
      }
    ],
    "files": [
      "%ProgramFiles%\\apache-maven-*\\bin\\mvn.cmd"
    ]
  },
  "versions": [
    {
      "version": "3.10.0",
      "channel": "stable",
      "recommended": true,
      "arch": "x64",
      "sizeBytes": 10102082,
      "installScope": "user",
      "source": {
        "url": "https://archive.apache.org/dist/maven/maven-3/3.10.0/binaries/apache-maven-3.10.0-bin.zip",
        "sha256": "1f6d9909266510f039f59aa0e13dcd2c66da85f043e56276e41f2918f8bddaff"
      },
      "mirrors": [
        {
          "name": "huaweicloud",
          "url": "https://mirrors.huaweicloud.com/apache/maven/maven-3/3.10.0/binaries/apache-maven-3.10.0-bin.zip"
        }
      ],
      "install": {
        "type": "zip",
        "template": "zip-into-version-dir",
        "params": {
          "stripComponents": "1"
        }
      },
      "uninstall": {
        "type": "custom"
      },
      "activate": {
        "pathEntries": [
          "{currentDir}\\bin"
        ],
        "env": {
          "MAVEN_HOME": "{currentDir}"
        }
      },
      "verify": {
        "cmd": "{installDir}\\bin\\mvn.cmd",
        "args": [
          "-v"
        ],
        "expectRegex": "Apache Maven \\d+"
      }
    },
    {
      "version": "3.9.16",
      "channel": "stable",
      "arch": "x64",
      "sizeBytes": 9395475,
      "installScope": "user",
      "source": {
        "url": "https://archive.apache.org/dist/maven/maven-3/3.9.16/binaries/apache-maven-3.9.16-bin.zip",
        "sha256": "5af3b743dd8b876b5c45da33b676251e5f1687712644abb4ee519ca56e1d89ce"
      },
      "mirrors": [
        {
          "name": "huaweicloud",
          "url": "https://mirrors.huaweicloud.com/apache/maven/maven-3/3.9.16/binaries/apache-maven-3.9.16-bin.zip"
        }
      ],
      "install": {
        "type": "zip",
        "template": "zip-into-version-dir",
        "params": {
          "stripComponents": "1"
        }
      },
      "uninstall": {
        "type": "custom"
      },
      "activate": {
        "pathEntries": [
          "{currentDir}\\bin"
        ],
        "env": {
          "MAVEN_HOME": "{currentDir}"
        }
      },
      "verify": {
        "cmd": "{installDir}\\bin\\mvn.cmd",
        "args": [
