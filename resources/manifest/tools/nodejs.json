{
  "id": "nodejs",
  "category": "runtime",
  "tier": "L1",
  "status": "ready",
  "provider": "direct",
  "name": {
    "zh-CN": "Node.js",
    "en-US": "Node.js"
  },
  "description": {
    "zh-CN": "JavaScript 运行时，自带 npm。前端与 Node 后端开发的基础。",
    "en-US": "JavaScript runtime with npm bundled. Foundation for frontend and Node backend work."
  },
  "homepage": "https://nodejs.org",
  "license": {
    "spdx": "MIT",
    "redistributable": true
  },
  "detect": {
    "commands": [
      {
        "cmd": "node",
        "args": [
          "-v"
        ],
        "expectRegex": "v\\d+\\.\\d+"
      }
    ],
    "files": [
      "%ProgramFiles%\\nodejs\\node.exe"
    ],
    "registry": [
      {
        "hive": "HKLM",
        "view": "64",
        "path": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall",
        "match": {
          "DisplayName": "^Node\\.js"
        },
        "versionFrom": "DisplayVersion"
      }
    ]
  },
  "versions": [
    {
      "version": "24.21.0",
      "channel": "lts",
      "recommended": true,
      "arch": "x64",
      "installScope": "user",
      "source": {
        "url": "https://nodejs.org/dist/v24.21.0/node-v24.21.0-win-x64.zip",
        "sha256": "158f7685b44de51f6c0df1d153526cbcd3e1bc739a8dfc607721cef75de9e541"
      },
      "mirrors": [
        {
          "name": "huaweicloud",
          "url": "https://mirrors.huaweicloud.com/nodejs/v24.21.0/node-v24.21.0-win-x64.zip"
        },
        {
          "name": "aliyun",
          "url": "https://mirrors.aliyun.com/nodejs-release/v24.21.0/node-v24.21.0-win-x64.zip"
        },
        {
          "name": "tuna",
          "url": "https://mirrors.tuna.tsinghua.edu.cn/nodejs-release/v24.21.0/node-v24.21.0-win-x64.zip"
        }
      ],
      "install": {
        "type": "zip",
        "template": "zip-into-version-dir",
        "params": {
          "stripComponents": "1"
        }
      },
      "uninstall": {
        "type": "custom"
      },
      "activate": {
        "pathEntries": [
          "{currentDir}"
        ]
      },
      "verify": {
        "cmd": "{installDir}\\node.exe",
        "args": [
          "-v"
        ],
        "expectRegex": "v\\d+\\."
      }
    }
  ],
  "notes": {
    "zh-CN": "用官方 ZIP 而不是 MSI：ZIP 解压到版本目录，不需要管理员、不覆盖系统里已有的 Node、不写系统 PATH（安装 ≠ 激活）。实测镜像速度差异极大：华为云 8.2 MB/s、官方源 191 KB/s；清华镜像滞后（只到 v24.1.0），因此 404 必须能被当成可回退错误。",
    "en-US": "Official ZIP instead of the MSI: extracts into the version directory — no admin, no clobbering an existing Node, no system PATH edits (install != activate). Measured mirror speeds differ wildly (Huawei Cloud 8.2 MB/s vs 191 KB/s official); TUNA lags behind, so a 404 must stay a recoverable error."
  }
}
