{
  "id": "sevenzip",
  "category": "tool",
  "tier": "L1",
  "status": "ready",
  "provider": "direct",
  "name": {
    "zh-CN": "7-Zip",
    "en-US": "7-Zip"
  },
  "description": {
    "zh-CN": "压缩/解压工具，命令行 7z.exe 常被构建脚本依赖。",
    "en-US": "Archive tool; its 7z.exe CLI is commonly required by build scripts."
  },
  "homepage": "https://www.7-zip.org",
  "license": {
    "spdx": "LGPL-2.1-or-later",
    "redistributable": true
  },
  "detect": {
    "commands": [
      {
        "cmd": "7z",
        "args": [
          "i"
        ],
        "expectRegex": "7-Zip"
      }
    ],
    "files": [
      "%ProgramFiles%\\7-Zip\\7z.exe"
    ],
    "registry": [
      {
        "hive": "HKLM",
        "view": "64",
        "path": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall",
        "match": {
          "DisplayName": "^7-Zip"
        },
        "versionFrom": "DisplayVersion"
      }
    ]
  },
  "versions": [
    {
      "version": "26.04",
      "channel": "stable",
      "recommended": true,
      "arch": "x64",
      "sizeBytes": 2009088,
      "installScope": "machine",
      "source": {
        "url": "https://www.7-zip.org/a/7z2604-x64.msi",
        "sha256": "0b01334a418654293513449f61d6bfc99e5196ca371e3c3dc961eda57cd535c6"
      },
      "install": {
        "type": "msi",
        "template": "msi-install",
        "params": {
          "dirProperty": "INSTALLDIR"
        }
      },
      "uninstall": {
        "type": "registry"
      },
      "activate": {
        "pathEntries": [
          "{currentDir}"
        ]
      },
      "verify": {
        "cmd": "{installDir}\\7z.exe",
        "args": [
          "i"
        ],
        "expectRegex": "7-Zip"
      }
    }
  ],
  "notes": {
    "zh-CN": "这是清单里唯一需要管理员的项目：7-Zip 的 MSI 是 per-machine 安装（要写 HKLM 卸载项），所以会弹一次 UAC。仍然装进版本目录，卸载走 devkit 自己的删除逻辑。",
    "en-US": "The only manifest needing admin: the 7-Zip MSI is per-machine (it writes an HKLM uninstall entry), so one UAC prompt appears. It still installs into the version directory."
  }
}
