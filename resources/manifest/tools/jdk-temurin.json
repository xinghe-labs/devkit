{
  "id": "jdk-temurin",
  "category": "runtime",
  "tier": "L1",
  "status": "ready",
  "provider": "direct",
  "name": {
    "zh-CN": "Eclipse Temurin JDK",
    "en-US": "Eclipse Temurin JDK"
  },
  "description": {
    "zh-CN": "OpenJDK 的免费发行版，可自由分发（本项目不使用 Oracle JDK）。",
    "en-US": "A freely redistributable OpenJDK build (this project does not use Oracle JDK)."
  },
  "homepage": "https://adoptium.net",
  "license": {
    "spdx": "GPL-2.0-only WITH Classpath-exception-2.0",
    "redistributable": true
  },
  "detect": {
    "commands": [
      {
        "cmd": "java",
        "args": [
          "-version"
        ],
        "expectRegex": "version \"\\d+"
      },
      {
        "cmd": "javac",
        "args": [
          "-version"
        ],
        "expectRegex": "javac \\d+"
      }
    ],
    "registry": [
      {
        "hive": "HKLM",
        "view": "64",
        "path": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall",
        "match": {
          "DisplayName": "^Eclipse Temurin JDK"
        },
        "versionFrom": "DisplayVersion"
      }
    ]
  },
  "versions": [
    {
      "version": "25.0.4.1",
      "channel": "lts",
      "recommended": true,
      "arch": "x64",
      "releaseDate": "2026-08-21",
      "sizeBytes": 141167264,
      "installScope": "user",
      "source": {
        "url": "https://github.com/adoptium/temurin25-binaries/releases/download/jdk-25.0.4.1%2B1/OpenJDK25U-jdk_x64_windows_hotspot_25.0.4.1_1.zip",
        "sha256": "00c847d804f4a78e9f04f2683faf14fed898535b177b7fc704486cb0284e9283"
      },
      "install": {
        "type": "zip",
        "template": "zip-into-version-dir",
        "params": {
          "stripComponents": "1"
        }
      },
      "uninstall": {
        "type": "custom"
      },
      "activate": {
        "pathEntries": [
          "{currentDir}\\bin"
        ],
        "env": {
          "JAVA_HOME": "{currentDir}"
        }
      },
      "verify": {
        "cmd": "{installDir}\\bin\\java.exe",
        "args": [
          "-version"
        ],
        "expectRegex": "version \"\\d+"
      }
    },
    {
