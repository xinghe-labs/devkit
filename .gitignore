# 依赖
node_modules/
.pnpm-store/

# 构建产物
# 注意：不要忽略 build/ —— 它是 electron-builder 的 buildResources 目录（放图标），
# 需要入库。electron-vite 的产物在 out/，electron-builder 的产物在 release/。
out/
dist/
release/
*.tsbuildinfo

# Electron
.electron/
.electron-builder-cache/

# 日志与临时文件
*.log
npm-debug.log*
pnpm-debug.log*
.tmp/
.temp/

# 环境与密钥（绝不入库）
.env
.env.*
!.env.example
*.pem
*.key

# 编辑器 / 系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 测试与覆盖率
coverage/
