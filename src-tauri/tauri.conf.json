{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "devkit",
  "version": "1.0.0",
  "identifier": "io.github.devkit",
  "build": {
    "beforeDevCommand": "pnpm exec vite",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm exec vite build",
    "frontendDist": "../dist/renderer"
  },
  "app": {
    "windows": [
      {
        "title": "devkit",
        "width": 1280,
        "height": 880,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
