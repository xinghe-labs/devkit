{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "devkit",
  "version": "0.6.2",
  "identifier": "io.github.devkit",
  "build": {
    "beforeDevCommand": "pnpm dev:renderer",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build:renderer",
    "frontendDist": "../dist/renderer"
  },
  "app": {
    "windows": [
      {
        "title": "devkit",
        "width": 1280,
        "height": 880,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "targets": ["nsis"],
    "icon": []
  }
}
