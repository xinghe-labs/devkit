{
  "name": "devkit",
  "version": "1.0.0",
  "description": "一键开发环境部署器 — 在全新的 Windows 电脑上一键安装、配置并自检开发环境",
  "keywords": [
    "windows",
    "dev-environment",
    "installer",
    "tauri",
    "one-click"
  ],
  "author": "devkit contributors",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xinghe-labs/devkit.git"
  },
  "homepage": "https://github.com/xinghe-labs/devkit#readme",
  "bugs": {
    "url": "https://github.com/xinghe-labs/devkit/issues"
  },
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "manifest:check": "cargo run --release --manifest-path src-tauri/Cargo.toml -p devkit-manifest --bin manifest-check",
    "manifest:refresh": "tsx scripts/refresh-manifests.ts",
    "detect": "cargo run --release --manifest-path src-tauri/Cargo.toml -p devkit-cli --bin devkit-cli -- detect-report",
    "install:tool": "cargo run --release --manifest-path src-tauri/Cargo.toml -p devkit-cli --bin devkit-cli -- install"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "minimatch": "^11.0.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "ajv": "^8.20.0",
    "antd": "^6.7.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "i18next": "^26.7.2",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.13",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.1.12",
    "vitest": "^5.1.0",
    "zustand": "^5.1.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4"
  }
}
